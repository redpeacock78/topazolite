{
  "lineWidth": 100,
  "includes": ["package.json", "dprint.json", ".textlintrc.json"],
  "markdown": { "textWrap": "maintain" },
  "json": {},
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.28.1.wasm@a2d1c7317cd47255cffd9dea5586dc923c3fd0c1fcdf9ffb210e94256882b17d",
    "https://plugins.dprint.dev/json-0.25.2.wasm@811ca4c6f732bcd6f707bc2f42d42395bb4127cdf829960cf628a18fc149777e",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3"
  ],
  "exec": {
    "cwd": "${configDir}",
    "timeout": 600,
    "cacheKey": "1",
    "commands": [
      { "command": "raco fmt --width {{line_width}}", "exts": ["rkt"], "stdin": true },
      { "command": "sh tools/fstar-fmt.sh fst", "exts": ["fst"], "stdin": true },
      { "command": "sh tools/fstar-fmt.sh fsti", "exts": ["fsti"], "stdin": true }
    ]
  }
}
