    "lint:text:report": "textlint --config .textlintrc.json --format json docs/specification > textlint-report.json || :"
  },
  "devDependencies": {
    "@textlint-ja/textlint-rule-preset-ai-writing": "1.7.0",
    "dprint": "0.64.3",
